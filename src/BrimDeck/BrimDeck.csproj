<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\BrimDeck.Core\BrimDeck.Core.csproj" />
    <ProjectReference Include="..\BrimDeck.UI\BrimDeck.UI.csproj" />
    <ProjectReference Include="..\BrimDeck.Modules\BrimDeck.Modules.csproj" />
    <ProjectReference Include="..\..\mods\timers\BrimDeck.Timers.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.Management" Version="10.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
    <Resource Include="Assets\Fonts\*.ttf" />
    <Content Include="ThirdPartyNotices.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <StartupObject>BrimDeck.Program</StartupObject>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\BrimDeck.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <!-- A panel that mostly sits idle: no background collection thread, and a collector that compacts and returns memory rather
         than keeping room to grow into (see App.Memory.cs). -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <!-- Gen0MaxBudget: the youngest generation is collected after 4 MB of allocation instead of a budget taken from the processor's
       cache (12 MB on a 24 MB cache). What the panel allocates while it sits (readings, players) otherwise refills that room within
       a minute of a trim, and it all counts in the working set; a collection of this generation takes well under a millisecond. -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
    <RuntimeHostConfigurationOption Include="System.GC.Gen0MaxBudget" Value="4194304" />
  </ItemGroup>

  <Import Project="ReleaseVersion.targets" />
  <ItemGroup><InternalsVisibleTo Include="BrimDeck.ModuleTests" /></ItemGroup>
  <Import Project="InputMethods.Native.targets" />

  <ItemGroup><BundledModuleProject Include="../../mods/timers/BrimDeck.Timers.csproj" /></ItemGroup>
  <Target Name="CopyBundledModules" AfterTargets="Build">
    <MSBuild Projects="@(BundledModuleProject)" Targets="GetModulePackage" Properties="Configuration=$(Configuration);Platform=AnyCPU">
      <Output TaskParameter="TargetOutputs" ItemName="_BundledFiles" />
    </MSBuild>
    <Copy SourceFiles="@(_BundledFiles)" DestinationFiles="@(_BundledFiles->'$(TargetDir)mods/%(ModuleFolder)/%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishBundledModules" AfterTargets="ComputeFilesToPublish">
    <MSBuild Projects="@(BundledModuleProject)" Targets="GetModulePackage" Properties="Configuration=$(Configuration);Platform=AnyCPU">
      <Output TaskParameter="TargetOutputs" ItemName="_PublishBundledFiles" />
    </MSBuild>
    <ItemGroup><ResolvedFileToPublish Include="@(_PublishBundledFiles)"><RelativePath>mods/%(_PublishBundledFiles.ModuleFolder)/%(_PublishBundledFiles.Filename)%(_PublishBundledFiles.Extension)</RelativePath><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory></ResolvedFileToPublish></ItemGroup>
  </Target>

  <!-- The release build publishes the sensor service first and passes its SHA-256 here: the copy downloaded when the user turns
       enhanced sensors on must match it (Native.SensorSetup). A build without it uses BrimDeck.Sensors.exe beside BrimDeck.exe. -->
  <ItemGroup Condition="'$(SensorsSha256)' != ''">
    <AssemblyMetadata Include="SensorsSha256" Value="$(SensorsSha256)" />
  </ItemGroup>

  <!-- Published builds ship precompiled code and run it as compiled. With tiered compilation the runtime
       recompiles hot methods in the background minutes after launch, which showed as CPU bursts when a
       player or the expanded panel was first used. The framework keeps its own precompiled images
       (no composite image), and the 24 MB Windows projection stays IL: only a few of its methods are used. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishReadyToRunComposite>false</PublishReadyToRunComposite>
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishReadyToRunExclude Include="Microsoft.Windows.SDK.NET.dll" />
  </ItemGroup>

</Project>
