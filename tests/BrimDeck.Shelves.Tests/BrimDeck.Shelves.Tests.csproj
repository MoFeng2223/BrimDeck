<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DropShelf.Tests</AssemblyName>
    <RootNamespace>DropShelf.Tests</RootNamespace>
    <StartupObject>DropShelf.Tests.HostedProgram</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\BrimDeck.Shelves\BrimDeck.Shelves.csproj" />
    <!-- Compile the original tests without editing their expectations or replacing their production dependencies. -->
    <Compile Include="..\..\third_party\DropShelf\tests\DropShelf.Tests\*.cs" Link="Upstream\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
