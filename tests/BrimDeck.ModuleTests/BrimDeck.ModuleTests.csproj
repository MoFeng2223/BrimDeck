<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0-windows10.0.19041.0</TargetFramework><UseWPF>true</UseWPF><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><PlatformTarget>x64</PlatformTarget></PropertyGroup>
  <ItemGroup><ProjectReference Include="../../mods/timers/BrimDeck.Timers.csproj" /><ProjectReference Include="..\..\src\BrimDeck\BrimDeck.csproj" /><ProjectReference Include="..\..\mods\notes\BrimDeck.Sample.csproj" ReferenceOutputAssembly="false" /><ProjectReference Include="..\..\mods\usage-alerts\BrimDeck.UsageAlerts.csproj" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../BrimDeck.InspectionFixture/BrimDeck.InspectionFixture.csproj" ReferenceOutputAssembly="false" /><ProjectReference Include="../../tools/BrimDeck.ModuleCheck/BrimDeck.ModuleCheck.csproj" ReferenceOutputAssembly="false" /></ItemGroup>
  <!-- Ask each project for its actual output: normal bin/ and unified artifacts have different layouts. -->
  <Target Name="WriteModuleTestArtifacts" AfterTargets="Build">
    <MSBuild Projects="../../mods/notes/BrimDeck.Sample.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);Platform=AnyCPU"><Output TaskParameter="TargetOutputs" ItemName="_NotesOutput" /></MSBuild>
    <MSBuild Projects="../BrimDeck.InspectionFixture/BrimDeck.InspectionFixture.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);Platform=AnyCPU"><Output TaskParameter="TargetOutputs" ItemName="_InspectionOutput" /></MSBuild>
    <MSBuild Projects="../../tools/BrimDeck.ModuleCheck/BrimDeck.ModuleCheck.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);Platform=AnyCPU"><Output TaskParameter="TargetOutputs" ItemName="_CheckerOutput" /></MSBuild>
    <MSBuild Projects="../../mods/timers/BrimDeck.Timers.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);Platform=AnyCPU"><Output TaskParameter="TargetOutputs" ItemName="_TimerOutput" /></MSBuild>
    <WriteLinesToFile File="$(TargetDir)module-test-artifacts.txt" Overwrite="true" Encoding="UTF-8"
      Lines="@(_NotesOutput->'Notes=%(RootDir)%(Directory)');@(_InspectionOutput->'InspectionFixture=%(FullPath)');@(_CheckerOutput->'ModuleCheck=%(FullPath)');@(_TimerOutput->'Timers=%(RootDir)%(Directory)package/timers')" />
  </Target>
</Project>
