<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Preserve upstream pack URIs and namespaces; BrimDeck hosts this library, not a second Application. -->
    <AssemblyName>DropShelf</AssemblyName>
    <RootNamespace>DropShelf</RootNamespace>
    <Version>2.6.7</Version>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <UpstreamRoot>..\..\third_party\DropShelf\src\DropShelf</UpstreamRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(UpstreamRoot)\**\*.cs" Exclude="$(UpstreamRoot)\App.xaml.cs;$(UpstreamRoot)\obj\**;$(UpstreamRoot)\bin\**" LinkBase="Upstream" />
    <Page Include="$(UpstreamRoot)\**\*.xaml" Exclude="$(UpstreamRoot)\App.xaml;$(UpstreamRoot)\obj\**;$(UpstreamRoot)\bin\**" Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <Resource Include="$(UpstreamRoot)\Assets\DropShelf.ico" Link="Assets\DropShelf.ico" />
    <Resource Include="$(UpstreamRoot)\Assets\DropShelf-256.png" Link="Assets\DropShelf-256.png" />
    <None Include="..\..\third_party\DropShelf\LICENSE" Link="DropShelf.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="DropShelf.Tests" />
    <InternalsVisibleTo Include="BrimDeck.WindowsTests" />
  </ItemGroup>
</Project>
