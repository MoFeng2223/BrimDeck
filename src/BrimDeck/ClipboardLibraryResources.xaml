<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:BrimDeck">
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ClipboardResources.xaml"/></ResourceDictionary.MergedDictionaries>
  <!-- Scoped to clipboard surfaces; the same slim, arrowless treatment used by the native settings controls. -->
  <Style x:Key="LibraryScrollThumb" TargetType="Thumb">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
      <Border Background="Transparent" Padding="3"><Border x:Name="Handle" Background="{DynamicResource PanelTertiary}" CornerRadius="3" Opacity=".6"/></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Handle" Property="Opacity" Value="1"/></Trigger>
        <Trigger Property="IsDragging" Value="True"><Setter TargetName="Handle" Property="Background" Value="{DynamicResource PanelAccent}"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="10"/><Setter Property="MinWidth" Value="0"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
      <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
        <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
        <Track.Thumb><Thumb Style="{StaticResource LibraryScrollThumb}"/></Track.Thumb>
        <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
      </Track>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers><Trigger Property="Orientation" Value="Horizontal">
      <Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="10"/><Setter Property="MinHeight" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Track x:Name="PART_Track" Orientation="Horizontal" IsDirectionReversed="False" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
          <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb Style="{StaticResource LibraryScrollThumb}"/></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
        </Track>
      </ControlTemplate></Setter.Value></Setter>
    </Trigger></Style.Triggers>
  </Style>
  <Style x:Key="LibraryButton" TargetType="Button" BasedOn="{StaticResource PanelIconButton}">
    <Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="10,0"/>
    <Setter Property="FontSize" Value="12"/><Setter Property="Background" Value="{DynamicResource PanelSwitchFill}"/>
    <Style.Triggers>
      <Trigger Property="Tag" Value="Selected"><Setter Property="Background" Value="{DynamicResource PanelFillSelected}"/><Setter Property="Foreground" Value="{DynamicResource PanelPrimary}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger>
    </Style.Triggers>
  </Style>
  <!-- Accent outlines preserve the panel palette's text contrast, even when a custom theme uses a pale accent. -->
  <Style x:Key="LibraryPrimaryButton" TargetType="Button" BasedOn="{StaticResource LibraryButton}">
    <Setter Property="Background" Value="{DynamicResource PanelFillSelected}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PanelAccent}"/>
    <Setter Property="Foreground" Value="{DynamicResource PanelPrimary}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <!-- Deletion is separated from commit actions; the irreversible confirmation, not this entry point, carries the warning. -->
  <Style x:Key="LibraryDangerButton" TargetType="Button" BasedOn="{StaticResource LibraryButton}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PanelPopupBorder}"/>
    <Setter Property="Foreground" Value="{DynamicResource PanelPrimary}"/>
  </Style>
  <Style x:Key="LibraryNav" TargetType="Button" BasedOn="{StaticResource LibraryButton}">
    <Setter Property="Height" Value="34"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Grid>
        <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource PanelR6}"/>
        <Border x:Name="HoverLayer" Background="{DynamicResource PanelHover}" CornerRadius="{DynamicResource PanelR6}" Opacity="0"/>
        <Border x:Name="PressLayer" Background="{DynamicResource PanelPressed}" CornerRadius="{DynamicResource PanelR6}" Opacity="0"/>
        <Border Padding="10,0" Background="Transparent"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/></Border>
        <Border x:Name="ColorSelection" BorderBrush="{DynamicResource PanelAccent}" BorderThickness="2" CornerRadius="{DynamicResource PanelR6}" IsHitTestVisible="False" Visibility="Collapsed"/>
        <Border x:Name="DropInto" BorderBrush="{DynamicResource PanelAccent}" BorderThickness="1" CornerRadius="{DynamicResource PanelR6}" IsHitTestVisible="False" Visibility="Collapsed"/>
        <Border x:Name="DropBefore" Background="{DynamicResource PanelAccent}" Height="2" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Collapsed"/>
        <Border x:Name="DropAfter" Background="{DynamicResource PanelAccent}" Height="2" VerticalAlignment="Bottom" IsHitTestVisible="False" Visibility="Collapsed"/>
      </Grid>
      <ControlTemplate.Triggers>
        <MultiTrigger><MultiTrigger.Conditions><Condition Property="local:ClipboardCollectionVisuals.HasColor" Value="True"/><Condition Property="Tag" Value="Selected"/></MultiTrigger.Conditions><Setter TargetName="ColorSelection" Property="Visibility" Value="Visible"/></MultiTrigger>
        <MultiTrigger><MultiTrigger.Conditions><Condition Property="local:ClipboardCollectionVisuals.HasColor" Value="True"/><Condition Property="IsKeyboardFocused" Value="True"/></MultiTrigger.Conditions><Setter TargetName="ColorSelection" Property="Visibility" Value="Visible"/></MultiTrigger>
        <Trigger Property="local:ClipboardDragDrop.Hint" Value="Into"><Setter TargetName="DropInto" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="local:ClipboardDragDrop.Hint" Value="Before"><Setter TargetName="DropBefore" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="local:ClipboardDragDrop.Hint" Value="After"><Setter TargetName="DropAfter" Property="Visibility" Value="Visible"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="LibraryCollectionNav" TargetType="Button" BasedOn="{StaticResource LibraryNav}">
    <Style.Triggers><Trigger Property="local:ClipboardCollectionVisuals.HasColor" Value="True">
      <Setter Property="Background" Value="{Binding RelativeSource={RelativeSource Self}, Path=(local:ClipboardCollectionVisuals.Fill)}"/><Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource Self}, Path=(local:ClipboardCollectionVisuals.Ink)}"/>
    </Trigger></Style.Triggers>
  </Style>
  <Style x:Key="LibraryField" TargetType="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource PanelPrimary}"/><Setter Property="CaretBrush" Value="{DynamicResource PanelPrimary}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource PanelAccent}"/><Setter Property="Background" Value="{DynamicResource PanelFill}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PanelPopupBorder}"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="8,6"/><Setter Property="FontSize" Value="12"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
      <!-- TextBoxView already applies the control's padding; repeating it on the border clips a single line. -->
      <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource PanelR6}">
        <Grid>
          <TextBlock x:Name="Watermark" Text="{TemplateBinding Tag}" Foreground="{DynamicResource PanelTertiary}" Margin="{TemplateBinding Padding}" Visibility="Collapsed" IsHitTestVisible="False" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
        </Grid>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="Text" Value=""><Setter TargetName="Watermark" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource PanelAccent}"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- The tray's leaf-only template has no submenu popup; filtering needs an actual keyboard-accessible hierarchy. -->
  <Style x:Key="LibraryMenuItem" TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource PanelPrimary}"/><Setter Property="Height" Value="28"/>
    <Setter Property="FontSize" Value="12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
      <Grid>
        <Border x:Name="Chrome" Background="Transparent" Padding="8,0" CornerRadius="{DynamicResource PanelR5}">
          <DockPanel><TextBlock x:Name="Arrow" Text="›" DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center"/><ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/></DockPanel>
        </Border>
        <Popup x:Name="PART_Popup" Placement="Right" PlacementTarget="{Binding ElementName=Chrome}" IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False">
          <Border Background="{DynamicResource PanelPopup}" BorderBrush="{DynamicResource PanelPopupBorder}" BorderThickness="1" CornerRadius="{DynamicResource PanelR8}" Padding="5">
            <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></ScrollViewer>
          </Border>
        </Popup>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="HasItems" Value="False"><Setter TargetName="Arrow" Property="Visibility" Value="Collapsed"/></Trigger>
        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PanelHover}"/></Trigger>
        <Trigger Property="IsSubmenuOpen" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PanelHover}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value=".4"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="LibraryComboItem" TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource PanelPrimary}"/><Setter Property="Padding" Value="8,6"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
      <Border x:Name="Chrome" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource PanelR5}"><ContentPresenter/></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PanelHover}"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PanelFillSelected}"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="LibraryCombo" TargetType="ComboBox">
    <Setter Property="Foreground" Value="{DynamicResource PanelPrimary}"/><Setter Property="Background" Value="{DynamicResource PanelFill}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PanelPopupBorder}"/><Setter Property="ItemContainerStyle" Value="{StaticResource LibraryComboItem}"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
      <Grid>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource PanelR6}">
          <Grid Margin="8,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <Path Grid.Column="1" Data="M 1,1 L 4,4 L 7,1" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2" Width="8" Height="5" VerticalAlignment="Center" HorizontalAlignment="Right"/>
          </Grid>
        </Border>
        <ToggleButton Focusable="False" local:Feedback.Fade="True" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Background="Transparent">
          <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Grid Background="Transparent">
            <Border x:Name="HoverLayer" Background="{DynamicResource PanelHover}" CornerRadius="{DynamicResource PanelR6}" Opacity="0"/>
            <Border x:Name="PressLayer" Background="{DynamicResource PanelPressed}" CornerRadius="{DynamicResource PanelR6}" Opacity="0"/>
          </Grid></ControlTemplate></ToggleButton.Template>
        </ToggleButton>
        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" Placement="Bottom">
          <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Padding="4" Background="{DynamicResource PanelPopup}" BorderBrush="{DynamicResource PanelPopupBorder}" BorderThickness="1" CornerRadius="{DynamicResource PanelR6}">
            <ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
          </Border>
        </Popup>
      </Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="LibraryRow" TargetType="ListBoxItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,8"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
      <Border x:Name="Chrome" BorderThickness="1" BorderBrush="Transparent" Background="{DynamicResource PanelFill}" CornerRadius="{DynamicResource PanelR8}" Padding="10">
        <ContentPresenter/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource PanelSecondary}"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource PanelAccent}"/></Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource PanelAccent}"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
