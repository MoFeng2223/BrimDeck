<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:BrimDeck">
  <Style x:Key="TimerStepButton" TargetType="RepeatButton">
    <Setter Property="Background" Value="{DynamicResource PanelFillSelected}"/>
    <Setter Property="Foreground" Value="{DynamicResource PanelPrimary}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="local:Feedback.Fade" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource PanelKeyboardFocus}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
      <Grid x:Name="ButtonRoot" RenderTransformOrigin=".5,.5">
        <Grid.RenderTransform><ScaleTransform x:Name="PressScale"/></Grid.RenderTransform>
        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="8"/>
        <Border x:Name="HoverLayer" Background="{DynamicResource PanelHover}" CornerRadius="8" Opacity="0"/>
        <Border x:Name="PressLayer" Background="{DynamicResource PanelPressed}" CornerRadius="8" Opacity="0"/>
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
      <ControlTemplate.Triggers>
        
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonRoot" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX=".9" ScaleY=".9"/></Setter.Value></Setter></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".28"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ModuleKeyboardFocus" TargetType="Control"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control"><Ellipse Stroke="{DynamicResource PanelAccent}" StrokeThickness="1"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="ModuleControl" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="ToolTipService.IsEnabled" Value="False"/><Setter Property="FocusVisualStyle" Value="{StaticResource ModuleKeyboardFocus}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Grid Background="Transparent" RenderTransformOrigin=".5,.5">
        <Grid.RenderTransform><ScaleTransform x:Name="ControlScale"/></Grid.RenderTransform>
        <Ellipse x:Name="Hover" Fill="{DynamicResource PanelPrimary}" Opacity="0" Stretch="Uniform"/>
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".28"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
