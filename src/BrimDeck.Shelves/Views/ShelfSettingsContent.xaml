<UserControl x:Class="DropShelf.Views.ShelfSettingsContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DropShelf.Views.Controls"
    xmlns:l="clr-namespace:DropShelf.Localization"
    xmlns:models="clr-namespace:DropShelf.Models">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- Reused upstream action and history templates; only the surrounding settings shell is replaced. -->
        <SolidColorBrush x:Key="DeleteBrush" Color="#E5000F" />
        <SolidColorBrush x:Key="LockedBrush" Color="#808080" />
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" /><Setter Property="Margin" Value="0,16,0,6" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <DataTemplate x:Key="CustomActionButtons">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource IconButtonStyle}" Content="{StaticResource Glyph.Edit}" FontSize="14" ToolTip="{l:Loc EditTooltip}" Command="{Binding EditCommand}" />
                <Button Style="{StaticResource IconButtonStyle}" Content="{StaticResource Glyph.Delete}" FontSize="14" Margin="4,0,0,0" ToolTip="{l:Loc DeleteTooltip}" Click="OnDeleteActionClick" />
            </StackPanel>
        </DataTemplate>
        <Style x:Key="ActionCardStyle" TargetType="Border">
            <Setter Property="MinHeight" Value="62" /><Setter Property="Padding" Value="16,10,12,10" />
            <Setter Property="CornerRadius" Value="6" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource CardBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="Cursor" Value="Hand" /><Setter Property="ToolTip" Value="{Binding Description}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDragSource}" Value="True"><Setter Property="Opacity" Value="0.4" /></DataTrigger>
                <DataTrigger Binding="{Binding IsDropTarget}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentFaintBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HoverButtonsStyle" TargetType="ContentPresenter">
            <Setter Property="ContentTemplate" Value="{StaticResource CustomActionButtons}" /><Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions>
                <Condition Binding="{Binding IsCustom}" Value="True" /><Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True" />
            </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers>
        </Style>
        <DataTemplate x:Key="ActionSlotTemplate">
            <Border Style="{StaticResource ActionCardStyle}" Margin="0,0,4,4" Padding="10,14,10,12"><Grid>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="20" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Title}" FontSize="14" Margin="0,10,0,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Grid Height="20" Margin="0,3,0,0">
                        <TextBlock Text="{Binding Position}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Border CornerRadius="10" Padding="8,2,10,3" HorizontalAlignment="Center" Background="{DynamicResource AccentBrush}" Visibility="{Binding IsDropTarget, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding DropHint}" FontSize="12" Foreground="{DynamicResource TextOnAccentBrush}" />
                        </Border>
                    </Grid>
                </StackPanel>
                <ContentPresenter Content="{Binding}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-4,0" Style="{StaticResource HoverButtonsStyle}" />
            </Grid></Border>
        </DataTemplate>
        <DataTemplate x:Key="MoreActionTemplate">
            <Border Style="{StaticResource ActionCardStyle}" Margin="0,0,0,4"><Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Description}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <ContentPresenter Grid.Column="2" Content="{Binding}" VerticalAlignment="Center" Style="{StaticResource HoverButtonsStyle}" />
            </Grid></Border>
        </DataTemplate>
        <Style x:Key="MiniStackCardStyle" TargetType="Border">
            <Setter Property="Width" Value="60" /><Setter Property="Height" Value="60" /><Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource ShelfTileBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ShelfTileBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" /><Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Hidden" /></DataTrigger></Style.Triggers>
        </Style>
        <DataTemplate x:Key="MiniThumbnailTemplate"><Grid Margin="6">
            <Image Source="{Binding Image}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}">
                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasImage}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
        </Grid></DataTemplate>
        <Style x:Key="FanCardStyle" TargetType="Button">
            <Setter Property="Width" Value="150" /><Setter Property="Height" Value="200" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Bd" Background="{DynamicResource FlyoutBrush}" BorderBrush="{DynamicResource FlyoutBorderBrush}" BorderThickness="1" CornerRadius="12"><ContentPresenter /></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="controls:FanPanel.IsHot" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.85" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="HotOnlyStyle" TargetType="FrameworkElement">
            <Setter Property="Opacity" Value="0" /><Style.Triggers><Trigger Property="controls:FanPanel.IsHot" Value="True"><Setter Property="Opacity" Value="1" /></Trigger></Style.Triggers>
        </Style>
        <DataTemplate x:Key="HistoryCardTemplate">
            <Button Style="{StaticResource FanCardStyle}" Command="{Binding RestoreCommand}" ToolTip="{l:Loc RestoreShelf}"><Grid>
                <StackPanel Margin="12,16,12,0">
                    <Viewbox Height="60" Stretch="Uniform"><Canvas Width="120" Height="84">
                        <Border Style="{StaticResource MiniStackCardStyle}" Canvas.Left="30" Canvas.Top="14" DataContext="{Binding Stack2}"><Border.RenderTransform><TransformGroup><RotateTransform Angle="-10" /><TranslateTransform X="-10" Y="2" /></TransformGroup></Border.RenderTransform><ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource MiniThumbnailTemplate}" /></Border>
                        <Border Style="{StaticResource MiniStackCardStyle}" Canvas.Left="30" Canvas.Top="13" DataContext="{Binding Stack1}"><Border.RenderTransform><TransformGroup><RotateTransform Angle="7" /><TranslateTransform X="9" Y="1" /></TransformGroup></Border.RenderTransform><ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource MiniThumbnailTemplate}" /></Border>
                        <Border Style="{StaticResource MiniStackCardStyle}" Canvas.Left="30" Canvas.Top="12" DataContext="{Binding Stack0}"><ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource MiniThumbnailTemplate}" /></Border>
                    </Canvas></Viewbox>
                    <TextBlock Text="{Binding Title}" FontSize="13" Margin="0,10,0,0" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36" LineHeight="18" />
                    <TextBlock Text="{Binding Detail}" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Border x:Name="RestoreHint" Style="{StaticResource HotOnlyStyle}" Margin="0,10,0,0" Padding="10,2,10,3" CornerRadius="10" HorizontalAlignment="Center" Background="{DynamicResource AccentBrush}"><TextBlock Text="{l:Loc ClickToRestore}" FontSize="11" Foreground="{DynamicResource TextOnAccentBrush}" /></Border>
                </StackPanel>
                <Button Content="{StaticResource Glyph.Close}" FontSize="9" Width="24" Height="24" Margin="0,4,4,0" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="{l:Loc RemoveHistoryTooltip}" Command="{Binding RemoveCommand}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}"><Setter Property="Visibility" Value="Hidden" /><Style.Triggers><Trigger Property="controls:FanPanel.IsHot" Value="True"><Setter Property="Visibility" Value="Visible" /></Trigger></Style.Triggers></Style></Button.Style></Button>
            </Grid></Button>
        </DataTemplate>
    </UserControl.Resources>
    <Grid x:Name="LayoutRoot" Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel x:Name="SectionTabs" Orientation="Horizontal" Margin="0,8,0,16">
            <Button x:Name="ShelfTab" Tag="Shelf" Click="OnSectionClick" Content="{l:Loc GesturesAndShelf}" Margin="0,0,8,0" />
            <Button Tag="Actions" Click="OnSectionClick" Content="{l:Loc QuickActionsTitle}" Margin="0,0,8,0" />
            <Button Tag="History" Click="OnSectionClick" Content="{l:Loc RecentShelves}" Margin="0,0,8,0" />
            <Button Tag="Help" Click="OnSectionClick" Content="{l:Loc Tutorial}" />
        </StackPanel>
        <ScrollViewer x:Name="ShelfScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="0,0,6,20">
                <TextBlock x:Name="PlacementNote" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,0,0,12" />
                <StackPanel x:Name="FloatingOptions">
                    <controls:SettingsCard Header="{l:Loc TriggerHeader}" Description="{l:Loc TriggerDescription}"><ListBox x:Name="TriggerSelector" Style="{StaticResource SegmentedStyle}" SelectedValuePath="Tag" SelectedValue="{Binding Trigger}"><ListBoxItem Content="{l:Loc TriggerShake}" Tag="{x:Static models:AutoOpenTrigger.Shake}" /><ListBoxItem Content="{l:Loc TriggerEdge}" Tag="{x:Static models:AutoOpenTrigger.Edge}" /><ListBoxItem Content="{l:Loc TriggerBoth}" Tag="{x:Static models:AutoOpenTrigger.Both}" /></ListBox></controls:SettingsCard>
                    <controls:SettingsCard Header="{l:Loc ShakeSensitivity}" Description="{Binding SensitivityDescription}" Visibility="{Binding UsesShake, Converter={StaticResource BoolToVisibility}}"><Slider x:Name="SensitivitySlider" Width="200" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Sensitivity}" AutomationProperties.Name="{l:Loc ShakeSensitivity}" /></controls:SettingsCard>
                    <controls:SettingsCard Header="{l:Loc EdgeDwellHeader}" Description="{l:Loc EdgeDwellDescription}" Visibility="{Binding UsesEdge, Converter={StaticResource BoolToVisibility}}"><ListBox Style="{StaticResource SegmentedStyle}" SelectedValuePath="Tag" SelectedValue="{Binding EdgeDwell}"><ListBoxItem Content="{l:Loc DwellShort}" Tag="{x:Static models:EdgeDwellTime.Short}" /><ListBoxItem Content="{l:Loc DwellMedium}" Tag="{x:Static models:EdgeDwellTime.Medium}" /><ListBoxItem Content="{l:Loc DwellLong}" Tag="{x:Static models:EdgeDwellTime.Long}" /></ListBox></controls:SettingsCard>
                    <controls:SettingsCard Header="{l:Loc GlobalHotkey}" Description="{Binding HotkeyDescription}"><controls:HotkeyBox x:Name="HotkeyEditor" Gesture="{Binding Hotkey}" /></controls:SettingsCard>
                    <controls:SettingsCard Header="{l:Loc BlockedAppsHeader}" Description="{l:Loc BlockedAppsDescription}"><Button x:Name="AddBlockedAppButton" Content="{l:Loc AddApp}" Click="OnAddBlockedAppClick" /></controls:SettingsCard>
                    <ItemsControl ItemsSource="{Binding BlockedApps}"><ItemsControl.ItemTemplate><DataTemplate><controls:SettingsCard Header="{Binding}" MinHeight="40" Padding="12,4"><Button Style="{StaticResource IconButtonStyle}" Content="{StaticResource Glyph.Delete}" CommandParameter="{Binding}" Command="{Binding DataContext.RemoveBlockedAppCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" ToolTip="{l:Loc RemoveBlockedApp}" /></controls:SettingsCard></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <controls:SettingsCard Header="{l:Loc Size}" Description="{l:Loc SizeDescription}"><ListBox Style="{StaticResource SegmentedStyle}" SelectedValuePath="Tag" SelectedValue="{Binding ShelfSize}"><ListBoxItem Content="{l:Loc SizeSmall}" Tag="{x:Static models:QuickShelfSize.Small}" /><ListBoxItem Content="{l:Loc SizeMedium}" Tag="{x:Static models:QuickShelfSize.Medium}" /><ListBoxItem Content="{l:Loc SizeLarge}" Tag="{x:Static models:QuickShelfSize.Large}" /></ListBox></controls:SettingsCard>
                </StackPanel>
                <controls:SettingsCard Header="{l:Loc DragOutModeHeader}" Description="{l:Loc DragOutModeDescription}"><ListBox Style="{StaticResource SegmentedStyle}" SelectedValuePath="Tag" SelectedValue="{Binding DragOutMode}"><ListBoxItem Content="{l:Loc TransferCopy}" Tag="{x:Static models:TransferMode.Copy}" /><ListBoxItem Content="{l:Loc TransferMove}" Tag="{x:Static models:TransferMode.Move}" /></ListBox></controls:SettingsCard>
                <controls:SettingsCard Header="{l:Loc CloseWhenEmpty}" Description="{l:Loc CloseWhenEmptyDescription}"><CheckBox Style="{DynamicResource ToggleSwitchStyle}" IsChecked="{Binding CloseWhenEmpty}" /></controls:SettingsCard>
            </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="ActionsScroll" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel x:Name="ActionsPage" Margin="0,0,6,24" PreviewMouseLeftButtonDown="OnActionCardMouseDown" PreviewMouseMove="OnActionCardMouseMove" PreviewMouseLeftButtonUp="OnActionCardMouseUp" LostMouseCapture="OnActionCardLostCapture">
                <TextBlock Text="{l:Loc ActionsPageDescription}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="2,0,0,16" />
                <controls:SettingsCard Header="{l:Loc ActionLayoutHeader}" Description="{l:Loc ActionLayoutDescription}"><ListBox x:Name="ActionLayoutSelector" Style="{StaticResource SegmentedStyle}" SelectedValuePath="Tag" SelectedValue="{Binding ActionLayout}"><ListBoxItem Content="{l:Loc LayoutOff}" Tag="{x:Static models:QuickActionLayout.Off}" /><ListBoxItem Content="{l:Loc LayoutTwo}" Tag="{x:Static models:QuickActionLayout.Two}" /><ListBoxItem Content="{l:Loc LayoutFour}" Tag="{x:Static models:QuickActionLayout.Four}" /></ListBox></controls:SettingsCard>
                <StackPanel Visibility="{Binding HasActionSlots, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{l:Loc CurrentActions}" Style="{StaticResource SectionHeaderTextStyle}" /><TextBlock Text="{l:Loc DragToSwapHint}" Style="{StaticResource CaptionTextStyle}" />
                    <ItemsControl x:Name="ActionSlotsList" ItemsSource="{Binding VisibleSlots}" Focusable="False" ItemTemplate="{StaticResource ActionSlotTemplate}" Margin="0,8,-4,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
                </StackPanel>
                <TextBlock Text="{l:Loc MoreActions}" Style="{StaticResource SectionHeaderTextStyle}" />
                <ItemsControl x:Name="MoreActionsList" ItemsSource="{Binding MoreActions}" Focusable="False" ItemTemplate="{StaticResource MoreActionTemplate}" />
                <Button x:Name="AddCustomActionButton" Content="{l:Loc AddCustomAction}" HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding AddCustomActionCommand}" IsEnabled="{Binding CanAddCustomAction}" />
            </StackPanel>
        </ScrollViewer>
        <Grid x:Name="HistoryPage" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <DockPanel><Button Content="{l:Loc Clear}" Command="{Binding ClearHistoryCommand}" DockPanel.Dock="Right" /><TextBlock Text="{Binding HistoryDescription}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" /></DockPanel>
            <ItemsControl x:Name="HistoryList" Grid.Row="1" VerticalAlignment="Bottom" ItemsSource="{Binding HistoryEntries}" ItemTemplate="{StaticResource HistoryCardTemplate}" Focusable="False" Height="165" Margin="0,4,0,4" PreviewMouseLeftButtonDown="OnHistoryMouseDown" PreviewMouseMove="OnHistoryMouseMove" PreviewMouseLeftButtonUp="OnHistoryMouseUp" LostMouseCapture="OnHistoryLostCapture"><ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:FanPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
        </Grid>
        <ScrollViewer x:Name="HelpPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
            <TextBlock Text="{l:Loc OnboardingWelcomeBody}" TextWrapping="Wrap" Margin="0,0,0,20" />
            <TextBlock Text="{l:Loc OnboardingShakeTitle}" Style="{StaticResource SectionHeaderTextStyle}" />
            <TextBlock Text="{l:Loc OnboardingShakeBody}" TextWrapping="Wrap" Margin="0,0,0,16" />
            <TextBlock Text="{l:Loc OnboardingStackTitle}" Style="{StaticResource SectionHeaderTextStyle}" />
            <TextBlock Text="{l:Loc HostStackHelp}" TextWrapping="Wrap" Margin="0,0,0,16" />
            <TextBlock Text="{l:Loc OnboardingActionsTitle}" Style="{StaticResource SectionHeaderTextStyle}" />
            <TextBlock x:Name="ActionHelp" TextWrapping="Wrap" Margin="0,0,0,16" />
            <TextBlock Text="{l:Loc DragOutModeDescription}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <TextBlock Text="{l:Loc ActionsPageDescription}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <TextBlock x:Name="CacheHelp" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel></ScrollViewer>
        <Grid x:Name="EditorOverlay" Grid.RowSpan="2" Background="{DynamicResource SmokeBrush}" Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibility}}">
            <Border x:Name="EditorDialog" MaxWidth="480" Margin="16" VerticalAlignment="Center" DataContext="{Binding Editor}" Background="{DynamicResource FlyoutBrush}" BorderBrush="{DynamicResource FlyoutBorderBrush}" BorderThickness="1" CornerRadius="8">
                <Grid><Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="480"><StackPanel Margin="24,20">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource SubtitleTextStyle}" />
                        <TextBlock Text="{l:Loc ActionKind}" Style="{StaticResource FieldLabelStyle}" />
                        <ListBox x:Name="EditorKindSelector" Style="{StaticResource SegmentedStyle}" HorizontalAlignment="Left" SelectedValuePath="Tag" SelectedValue="{Binding Kind}"><ListBoxItem Content="{l:Loc KindFolder}" Tag="{x:Static models:CustomActionKind.Folder}" /><ListBoxItem Content="{l:Loc KindCompressImage}" Tag="{x:Static models:CustomActionKind.CompressImage}" /><ListBoxItem Content="{l:Loc KindOpenWith}" Tag="{x:Static models:CustomActionKind.OpenWith}" /></ListBox>
                        <StackPanel Visibility="{Binding IsFolder, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{l:Loc FolderLabel}" Style="{StaticResource FieldLabelStyle}" /><DockPanel><Button Content="{l:Loc Browse}" DockPanel.Dock="Right" Margin="8,0,0,0" Click="OnBrowseFolderClick" /><TextBox x:Name="EditorFolderBox" Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" /></DockPanel>
                            <TextBlock Text="{l:Loc FolderModeLabel}" Style="{StaticResource FieldLabelStyle}" /><ListBox Style="{StaticResource SegmentedStyle}" HorizontalAlignment="Left" SelectedValuePath="Tag" SelectedValue="{Binding FolderMode}"><ListBoxItem Content="{l:Loc TransferMove}" Tag="{x:Static models:TransferMode.Move}" /><ListBoxItem Content="{l:Loc TransferCopy}" Tag="{x:Static models:TransferMode.Copy}" /></ListBox>
                        </StackPanel>
                        <StackPanel Visibility="{Binding IsCompressImage, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="{l:Loc ImageSizeLabel}" Style="{StaticResource FieldLabelStyle}" /><StackPanel Orientation="Horizontal"><TextBox Width="120" Text="{Binding SizeText, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Text="KB" Margin="10,0,0,0" VerticalAlignment="Center" /></StackPanel><TextBlock Text="{l:Loc ImageSizeHint}" Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,0" /></StackPanel>
                        <StackPanel Visibility="{Binding IsOpenWith, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="{l:Loc ProgramLabel}" Style="{StaticResource FieldLabelStyle}" /><DockPanel><Button Content="{l:Loc Browse}" DockPanel.Dock="Right" Margin="8,0,0,0" Click="OnBrowseProgramClick" /><TextBox Text="{Binding ProgramPath, UpdateSourceTrigger=PropertyChanged}" /></DockPanel><TextBlock Text="{l:Loc ArgumentsLabel}" Style="{StaticResource FieldLabelStyle}" /><TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" Tag="{}{files}" /><TextBlock Text="{l:Loc ArgumentsHint}" Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,0" /></StackPanel>
                        <TextBlock Text="{l:Loc NameLabel}" Style="{StaticResource FieldLabelStyle}" /><TextBox x:Name="EditorNameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding NamePlaceholder}" MaxLength="40" />
                        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource CriticalBrush}" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel></ScrollViewer>
                    <Border Grid.Row="1" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="24,16"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{l:Loc Save}" Command="{Binding SaveCommand}" Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0" /><Button Content="{l:Loc Cancel}" Command="{Binding CancelCommand}" /></StackPanel></Border>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="ConfirmOverlay" Grid.RowSpan="2" Background="{DynamicResource SmokeBrush}" Visibility="Collapsed"><Border Width="400" Margin="16" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24" CornerRadius="8" Background="{DynamicResource FlyoutBrush}" BorderBrush="{DynamicResource FlyoutBorderBrush}" BorderThickness="1" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform x:Name="ConfirmDialogScale" /></Border.RenderTransform><StackPanel><TextBlock Text="{l:Loc ConfirmDeleteTitle}" Style="{StaticResource SubtitleTextStyle}" /><TextBlock x:Name="ConfirmMessage" TextWrapping="Wrap" Margin="0,12,0,20" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{l:Loc DeleteTooltip}" Click="OnConfirmDeleteClick" Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0" /><Button x:Name="ConfirmCancelButton" Content="{l:Loc Cancel}" Click="OnConfirmCancelClick" /></StackPanel></StackPanel></Border></Grid>
        <Grid x:Name="DeleteZone" Grid.RowSpan="2" Height="120" VerticalAlignment="Bottom" IsHitTestVisible="False" Opacity="0"><Rectangle x:Name="DeleteGlow" Fill="{StaticResource DeleteBrush}" Opacity="0.35"><Rectangle.OpacityMask><LinearGradientBrush StartPoint="0,1" EndPoint="0,0"><GradientStop Color="Black" Offset="0" /><GradientStop Color="Transparent" Offset="1" /></LinearGradientBrush></Rectangle.OpacityMask></Rectangle><Border x:Name="DeleteHint" CornerRadius="14" Padding="12,5,14,6" Margin="0,0,0,28" HorizontalAlignment="Center" VerticalAlignment="Bottom" Background="{StaticResource DeleteBrush}" Opacity="0"><StackPanel Orientation="Horizontal"><TextBlock x:Name="DeleteHintGlyph" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,8,0" Foreground="White" /><TextBlock x:Name="DeleteHintText" FontSize="13" Foreground="White" /></StackPanel></Border></Grid>
        <Canvas x:Name="DragLayer" Grid.RowSpan="2" IsHitTestVisible="False"><Border x:Name="DragGhost" Visibility="Collapsed" CornerRadius="8" Padding="12,8,16,9" Background="{DynamicResource FlyoutBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"><Border.RenderTransform><TranslateTransform x:Name="DragGhostShift" /></Border.RenderTransform><StackPanel Orientation="Horizontal"><TextBlock x:Name="DragGhostGlyph" FontFamily="{StaticResource IconFont}" FontSize="16" Margin="0,1,10,0" Foreground="{DynamicResource AccentTextBrush}" /><TextBlock x:Name="DragGhostText" FontSize="13" /></StackPanel></Border></Canvas>
    </Grid>
</UserControl>
