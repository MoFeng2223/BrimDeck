<Project Sdk="Microsoft.NET.Sdk">
  <!-- Renders the README images from BrimDeck's own interface code with invented data. Usage is described at the top of Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <!-- DPI-unaware: layout rounds to whole DIPs, so a 2x capture maps every DIP to exactly two pixels. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\BrimDeck\BrimDeck.csproj" />
  </ItemGroup>
</Project>
